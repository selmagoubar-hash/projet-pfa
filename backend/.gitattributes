# Auto detect text files and perform LF normalization
* text=auto

# Specific for Python
*.py text eol=lf
*.pyc binary

# Specific for Django templates
*.html text eol=lf

# Specific for JavaScript/React
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary